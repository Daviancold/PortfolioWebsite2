    "next-mdx-remote": "^6.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "sass": "^1.86.3",
    "transliteration": "^2.3.5"
  },
