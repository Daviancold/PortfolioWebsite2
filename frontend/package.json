    "deps:prom-client": "node -e \"const deps=new Set();function t(p){try{const x=require(p+'/package.json');Object.keys(x.dependencies||{}).forEach(d=>{if(!deps.has(d)){deps.add(d);t(d)}});}catch{}}t('prom-client');console.log([...deps].join('\\n'))\""
